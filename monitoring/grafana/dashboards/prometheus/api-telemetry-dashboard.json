          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-stack-datasource"
          },
          "editorMode": "code",
          "expr": "sum(rate(task_api_http_requests_total[2m])) by (method, route)",
          "legendFormat": "{{method}} {{route}} - Total",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-stack-datasource"
          },
          "editorMode": "code",
          "expr": "sum(rate(task_api_http_requests_total{status_code=~\"5..\"}[2m])) by (method, route)",
